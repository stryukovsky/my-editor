#!/usr/bin/env python3
"""Let Zsh's edit-command-line wait for an editor in its parent Neovim."""
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time


def remote(server, expression):
    return subprocess.run(
        [os.environ.get("NVIM_COMMAND_EDITOR_BIN", "nvim"), "--server", server,
         "--remote-expr", expression],
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, timeout=5,
    )


def expression(method, payload):
    data = json.dumps(payload, ensure_ascii=True).replace("'", "''")
    return f'''luaeval("require('terminal_command').{method}(_A)", json_decode('{data}'))'''


def main():
    args = sys.argv[1:]
    offset = 1
    # Zsh recognizes 'vim' anywhere in the editor path and adds this cursor hint.
    if args[:1] == ["-c"]:
        hint = args[1].split() if len(args) > 1 else []
        if len(hint) == 2 and hint[0] == "normal!" and hint[1].endswith("go"):
            offset = int(hint[1][:-2])
        args = args[2:]
    if args[:1] == ["--"]:
        args = args[1:]
    server = os.environ.get("NVIM")
    if not server or len(args) != 1:
        print("This editor requires a terminal inside Neovim", file=sys.stderr)
        return 1
    path = str(Path(args[0]).resolve())
    with tempfile.TemporaryDirectory(prefix="nvim-command-") as directory:
        done = Path(directory) / "done"
        payload = {"path": path, "done": str(done), "cwd": os.getcwd(),
                   "offset": offset, "shell_pid": int(os.environ.get("NVIM_COMMAND_SHELL_PID", "0"))}
        original = Path(path).read_bytes()
        opened = False
        try:
            result = remote(server, expression("open", payload))
            if result.returncode:
                print(result.stderr.strip(), file=sys.stderr)
                return 1
            opened = True
            probe_at = time.monotonic() + 2
            while not done.exists():
                time.sleep(0.05)
                if time.monotonic() >= probe_at:
                    if remote(server, "1").returncode:
                        return 1
                    probe_at = time.monotonic() + 2
            if done.read_text().strip() != "0":
                Path(path).write_bytes(original)
            return 0
        except (KeyboardInterrupt, OSError, subprocess.TimeoutExpired):
            Path(path).write_bytes(original)
            return 1
        finally:
            if opened and not done.exists():
                try:
                    remote(server, expression("cancel", {"path": path}))
                except (OSError, subprocess.TimeoutExpired):
                    pass


if __name__ == "__main__":
    sys.exit(main())
