{
  "$schema": "../../../schemas/native-completion-language.schema.json",
  "version": 1,
  "language": "cpp",
  "identifier_nodes": [
    "identifier",
    "field_identifier",
    "type_identifier",
    "namespace_identifier"
  ],
  "string_nodes": [
    "string_literal",
    "string_content",
    "system_lib_string",
    "concatenated_string",
    "char_literal",
    "raw_string_literal",
    "raw_string_content",
    "raw_string_delimiter"
  ],
  "expressions": {
    "member": [
      "field_expression"
    ],
    "type": [
      "type_identifier",
      "primitive_type",
      "sized_type_specifier",
      "type_descriptor",
      "template_type",
      "type_parameter_declaration",
      "optional_type_parameter_declaration",
      "variadic_type_parameter_declaration"
    ],
    "import": [
      "preproc_include",
      "import_declaration",
      "using_declaration"
    ]
  },
  "string_contexts": {
    "import": [
      "preproc_include",
      "import_declaration"
    ]
  },
  "keywords": [
    "auto",
    "break",
    "case",
    "char",
    "const",
    "continue",
    "default",
    "do",
    "double",
    "else",
    "enum",
    "extern",
    "float",
    "for",
    "goto",
    "if",
    "inline",
    "int",
    "long",
    "register",
    "restrict",
    "return",
    "short",
    "signed",
    "sizeof",
    "static",
    "struct",
    "switch",
    "typedef",
    "union",
    "unsigned",
    "void",
    "volatile",
    "while",
    "alignas",
    "alignof",
    "atomic",
    "bool",
    "complex",
    "generic",
    "imaginary",
    "noreturn",
    "assert",
    "thread",
    "local",
    "nullptr",
    "constexpr",
    "typeof",
    "unqual",
    "bitint",
    "true",
    "false",
    "and",
    "asm",
    "bitand",
    "bitor",
    "catch",
    "class",
    "compl",
    "concept",
    "consteval",
    "constinit",
    "cast",
    "delete",
    "dynamic",
    "explicit",
    "export",
    "friend",
    "mutable",
    "namespace",
    "noexcept",
    "not",
    "operator",
    "or",
    "override",
    "private",
    "protected",
    "public",
    "reinterpret",
    "requires",
    "template",
    "this",
    "throw",
    "try",
    "typename",
    "typeid",
    "using",
    "virtual",
    "wchar",
    "char8",
    "char16",
    "char32",
    "xor",
    "eq",
    "co",
    "await",
    "yield",
    "final"
  ],
  "fixtures": [
    {
      "name": "method name",
      "source": "void run() { obj.pr<cursor>int(value); }",
      "expect": {
        "context": "member",
        "identifiers": [
          "run",
          "obj",
          "print",
          "value"
        ]
      }
    },
    {
      "name": "generic type",
      "source": "std::vector<Us<cursor>er> users;",
      "expect": {
        "context": "type",
        "identifiers": [
          "std",
          "vector",
          "User",
          "users"
        ]
      }
    },
    {
      "name": "template parameter",
      "source": "template<typename Us<cursor>er> void apply() {}",
      "expect": {
        "context": "type",
        "identifiers": [
          "User",
          "apply"
        ]
      }
    },
    {
      "name": "using namespace",
      "source": "using namespace exam<cursor>ple;",
      "expect": {
        "context": "import",
        "identifiers": [
          "example"
        ]
      }
    },
    {
      "name": "module import",
      "source": "import example.us<cursor>er;",
      "expect": {
        "context": "import",
        "identifiers": [
          "example",
          "user"
        ]
      }
    },
    {
      "name": "associated name neutral",
      "source": "void run() { User::cre<cursor>ate(); }",
      "expect": {
        "context": "unknown",
        "identifiers": [
          "run",
          "User",
          "create"
        ]
      }
    },
    {
      "name": "raw string",
      "source": "auto message = R\"(User<cursor>)\";",
      "expect": {
        "context": "unknown",
        "identifiers": [
          "message"
        ]
      }
    },
    {
      "name": "UTF string",
      "source": "auto message = u8\"User<cursor>\";",
      "expect": {
        "context": "unknown",
        "identifiers": [
          "message"
        ]
      }
    },
    {
      "name": "method call argument",
      "source": "void run() { obj.print(val<cursor>ue); }",
      "expect": {
        "context": "unknown",
        "identifiers": [
          "run",
          "obj",
          "print",
          "value"
        ]
      }
    },
    {
      "name": "lambda argument neutral",
      "source": "void run() { auto fn = [](User user) { apply(val<cursor>ue); }; }",
      "expect": {
        "context": "unknown",
        "identifiers": [
          "run",
          "fn",
          "User",
          "user",
          "apply",
          "value"
        ]
      }
    },
    {
      "name": "quoted header unit import",
      "source": "import \"us<cursor>er.h\";",
      "expect": {
        "context": "import",
        "identifiers": []
      }
    },
    {
      "name": "system header unit import",
      "source": "import <us<cursor>er.h>;",
      "expect": {
        "context": "import",
        "identifiers": []
      }
    }
  ],
  "extends": "c"
}
