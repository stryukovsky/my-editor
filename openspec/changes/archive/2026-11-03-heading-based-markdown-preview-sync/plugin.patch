+---@module 'luassert'
+local assert = require('luassert')
+local preview = require('render-markdown.core.preview')
+local util = require('tests.util')
+
+describe('preview heading navigation', function()
+    local src, dst, sw, pw
+    local function move(win, row, col)
+        vim.api.nvim_set_current_win(win)
+        vim.api.nvim_win_set_cursor(win, { row, col or 0 })
+        vim.api.nvim_exec_autocmds(
+            'CursorMoved',
+            { buffer = vim.api.nvim_win_get_buf(win) }
+        )
+        vim.wait(0)
+    end
+    local function open(lines, row)
+        util.setup.text(lines)
+        src = vim.api.nvim_get_current_buf()
+        pw = vim.api.nvim_get_current_win()
+        vim.cmd('split')
+        sw = vim.api.nvim_get_current_win()
+        vim.api.nvim_set_current_win(pw)
+        vim.api.nvim_win_set_cursor(pw, { row or 1, 0 })
+        preview.open()
+        dst = vim.api.nvim_get_current_buf()
+    end
+    local function edit(first, last, lines)
+        vim.api.nvim_buf_set_lines(src, first, last, false, lines)
+        vim.api.nvim_exec_autocmds('TextChanged', { buffer = src })
+    end
+    -- selene: allow(undefined_variable)
+    after_each(function()
+        if src then
+            preview.close(src)
+        end
+        vim.cmd('silent! only')
+    end)
+
+    it(
+        'follows section changes both ways without moving within a section or bouncing',
+        function()
+            open({
+                '# First',
+                'alpha',
+                'beta',
+                '## Child',
+                'child',
+                '',
+                '# First',
+                'tail',
+            })
+            move(sw, 5, 2)
+            assert.same({ 4, 0 }, vim.api.nvim_win_get_cursor(pw))
+            assert.same({ 5, 2 }, vim.api.nvim_win_get_cursor(sw))
+            assert.equal(sw, vim.api.nvim_get_current_win())
+            move(sw, 6)
+            assert.same({ 4, 0 }, vim.api.nvim_win_get_cursor(pw))
+            move(pw, 8, 2)
+            assert.same({ 7, 0 }, vim.api.nvim_win_get_cursor(sw))
+            assert.same({ 8, 2 }, vim.api.nvim_win_get_cursor(pw))
+            -- A delayed callback for the peer must not pull back the origin.
+            vim.api.nvim_exec_autocmds('CursorMoved', { buffer = src })
+            assert.same({ 8, 2 }, vim.api.nvim_win_get_cursor(pw))
+            move(pw, 2)
+            assert.same({ 1, 0 }, vim.api.nvim_win_get_cursor(sw))
+            assert.same({ 2, 0 }, vim.api.nvim_win_get_cursor(pw))
+        end
+    )
+
+    it(
+        'opens and closes at heading starts, including a hidden source',
+        function()
+            open({ 'intro', '', '# One', 'body', '# Two', 'tail' }, 4)
+            assert.same({ 3, 0 }, vim.api.nvim_win_get_cursor(pw))
+            vim.api.nvim_win_close(sw, true)
+            move(pw, 6)
+            preview.close(src)
+            assert.equal(src, vim.api.nvim_get_current_buf())
+            assert.same({ 5, 0 }, vim.api.nvim_win_get_cursor(pw))
+            preview.open(src)
+            dst = vim.api.nvim_get_current_buf()
+            assert.same({ 5, 0 }, vim.api.nvim_win_get_cursor(pw))
+        end
+    )
+
+    it(
+        'keeps preamble and heading-free movement at the document-start anchor',
+        function()
+            open({ 'intro', 'more', '', '# One', 'body' }, 2)
+            assert.same({ 1, 0 }, vim.api.nvim_win_get_cursor(pw))
+            move(sw, 2)
+            assert.same({ 1, 0 }, vim.api.nvim_win_get_cursor(pw))
+            edit(0, -1, { 'plain', 'text', 'tail' })
+            move(pw, 3)
+            preview.close(src)
+            assert.same({ 1, 0 }, vim.api.nvim_win_get_cursor(pw))
+        end
+    )
+
+    it(
+        'preserves heading identity across insertion, rename and deletion while preview is active',
+        function()
+            open({ '# Same', 'body', '# Same', 'selected', '# Last', 'tail' })
+            move(pw, 4)
+            local selected = preview.anchor[src]
+            edit(0, 0, { '# Inserted', '' })
+            assert.equal(selected, preview.anchor[src])
+            assert.same({ 5, 0 }, vim.api.nvim_win_get_cursor(pw))
+            edit(4, 5, { '# Renamed' })
+            assert.equal(selected, preview.anchor[src])
+            assert.equal('# Renamed', vim.api.nvim_get_current_line())
+            edit(4, 5, {})
+            assert.not_equal(selected, preview.anchor[src])
+            assert.same({ 3, 0 }, vim.api.nvim_win_get_cursor(pw))
+            assert.equal('# Same', vim.api.nvim_get_current_line())
+        end
+    )
+
+    it(
+        'uses the source current section when source edits shift rendered positions',
+        function()
+            open({ '# First', 'short', '', '# Second', 'tail' })
+            move(sw, 5)
+            edit(1, 2, { ('alpha '):rep(100) })
+            local heading = preview.docs[src].headings[2]
+            assert.is_true(heading.preview_row > heading.source_row)
+            assert.same(
+                { heading.preview_row + 1, 0 },
+                vim.api.nvim_win_get_cursor(pw)
+            )
+            assert.same({ 5, 0 }, vim.api.nvim_win_get_cursor(sw))
+        end
+    )
+
+    it('cleans pair state on wipeout without affecting another pair', function()
+        open({ '# One', 'body' })
+        local first = src
+        util.setup.text({ '# Other', 'body' })
+        local other = vim.api.nvim_get_current_buf()
+        preview.open()
+        local other_dst = vim.api.nvim_get_current_buf()
+        vim.api.nvim_buf_delete(dst, { force = true })
+        assert.is_nil(preview.docs[first])
+        assert.is_nil(preview.outlines[first])
+        assert.is_nil(preview.anchor[first])
+        assert.equal(other_dst, preview.buffers[other])
+        vim.api.nvim_buf_delete(other, { force = true })
+        assert.is_nil(preview.outlines[other])
+        assert.is_false(vim.api.nvim_buf_is_valid(other_dst))
+    end)
+
+    it('reopens an existing hidden preview at the source section', function()
+        open({ '# One', 'body', '# Two', 'tail' })
+        vim.api.nvim_win_set_buf(pw, src)
+        move(sw, 4)
+        vim.api.nvim_set_current_win(sw)
+        preview.open(src)
+        assert.equal(dst, vim.api.nvim_get_current_buf())
+        assert.same({ 3, 0 }, vim.api.nvim_win_get_cursor(sw))
+    end)
+    it(
+        'follows an actual document-symbol target after wrapped tables',
+        function()
+            open({
+                '# Same',
+                '',
+                '| A | B |',
+                '| --- | --- |',
+                '| ' .. ('word '):rep(50) .. ' | ' .. ('cell '):rep(30) .. ' |',
+                '',
+                '# Same',
+                'tail',
+            })
+            local symbols =
+                require('render-markdown.integ.lsp').symbols(dst, 'utf-8')
+            local target = symbols[2].selectionRange.start.line
+            assert.is_true(target > 6)
+            move(pw, target + 1)
+            assert.same({ 7, 0 }, vim.api.nvim_win_get_cursor(sw))
+            move(pw, target + 2)
+            assert.same({ 7, 0 }, vim.api.nvim_win_get_cursor(sw))
+            move(pw, 4)
+            assert.same({ 1, 0 }, vim.api.nvim_win_get_cursor(sw))
+            local position = vim.api.nvim_win_get_cursor(sw)
+            move(pw, 5)
+            assert.same(position, vim.api.nvim_win_get_cursor(sw))
+        end
+    )
+
+    it(
+        'returns to document start when the first selected heading is removed',
+        function()
+            open({ 'intro', '', '# First', 'body', '# Next', 'tail' })
+            move(pw, 4)
+            edit(2, 3, {})
+            assert.equal(0, preview.anchor[src])
+            assert.same({ 1, 0 }, vim.api.nvim_win_get_cursor(pw))
+            assert.same({ 1, 0 }, vim.api.nvim_win_get_cursor(sw))
+        end
+    )
+
+    it(
+        'retains the active preview section after a diagram finishes asynchronously',
+        function()
+            local original = vim.system
+            local done
+            vim.system = function(_, _, callback)
+                done = callback
+                return { kill = function() end }
+            end
+            local ok, err = pcall(function()
+                open({
+                    '# First',
+                    '',
+                    '```mermaid',
+                    'graph LR',
+                    'A-->B',
+                    '```',
+                    '',
+                    '# Last',
+                    'tail',
+                })
+                move(pw, 9)
+                local selected = preview.anchor[src]
+                done({ code = 0, stdout = 'diagram row\nrow two\n' })
+                assert.is_true(vim.wait(500, function()
+                    return vim.api.nvim_buf_get_lines(dst, 2, 3, false)[1]
+                        == 'diagram row'
+                end))
+                assert.equal(selected, preview.anchor[src])
+                assert.same({ 6, 0 }, vim.api.nvim_win_get_cursor(pw))
+                assert.same({ 8, 0 }, vim.api.nvim_win_get_cursor(sw))
+            end)
+            vim.system = original
+            assert.is_true(ok, err)
+        end
+    )
+end)
