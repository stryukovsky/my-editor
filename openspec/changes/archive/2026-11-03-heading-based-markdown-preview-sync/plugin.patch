new file mode 100644
index 0000000..fe482da
--- /dev/null
+++ b/lua/render-markdown/sync/outline.lua
@@ -0,0 +1,78 @@
+local sync = require('render-markdown.sync')
+local ns = vim.api.nvim_create_namespace('render-markdown.preview.headings')
+
+local M = {}
+
+---Track heading occurrences across source edits, without matching title text.
+---@param buf integer
+function M.new(buf)
+    local tracker = { buf = buf, headings = {}, active = true }
+    vim.api.nvim_buf_attach(buf, false, {
+        on_lines = function(_, _, _, first, last, new_last)
+            if not tracker.active then
+                return true
+            end
+            local delta = new_last - last
+            for _, heading in ipairs(tracker.headings) do
+                local row = heading.source_row
+                if row >= first and row < last then
+                    -- Equal-length replacements include whole-line renames.
+                    -- A shrinking range removes its headings rather than
+                    -- accidentally transferring identity to the next heading.
+                    if delta < 0 then
+                        vim.api.nvim_buf_del_extmark(buf, ns, heading.id)
+                    else
+                        vim.api.nvim_buf_set_extmark(buf, ns, row, 0, {
+                            id = heading.id,
+                            right_gravity = true,
+                        })
+                    end
+                end
+                local mark =
+                    vim.api.nvim_buf_get_extmark_by_id(buf, ns, heading.id, {})
+                if #mark > 0 then
+                    heading.source_row = mark[1]
+                end
+            end
+        end,
+    })
+
+    function tracker:rebuild()
+        local old = {}
+        for _, heading in ipairs(self.headings) do
+            local mark =
+                vim.api.nvim_buf_get_extmark_by_id(buf, ns, heading.id, {})
+            if #mark > 0 then
+                old[mark[1]] = heading.id
+            end
+        end
+        local headings = sync.headings(buf)
+        local retained = {}
+        for _, heading in ipairs(headings) do
+            heading.id =
+                vim.api.nvim_buf_set_extmark(buf, ns, heading.source_row, 0, {
+                    id = old[heading.source_row],
+                    right_gravity = true,
+                })
+            retained[heading.id] = true
+        end
+        for _, heading in ipairs(self.headings) do
+            if not retained[heading.id] then
+                vim.api.nvim_buf_del_extmark(buf, ns, heading.id)
+            end
+        end
+        self.headings = headings
+        return headings
+    end
+
+    function tracker:close()
+        self.active = false
+        if vim.api.nvim_buf_is_valid(buf) then
+            vim.api.nvim_buf_clear_namespace(buf, ns, 0, -1)
+        end
+        self.headings = {}
+    end
+    return tracker
+end
+
+return M
