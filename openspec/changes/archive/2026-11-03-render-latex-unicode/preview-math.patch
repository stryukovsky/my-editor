+++ b/tests/preview_transform_spec.lua
@@ -0,0 +1,63 @@
+---@module 'luassert'
+local assert = require('luassert')
+local preview = require('render-markdown.core.preview')
+local util = require('tests.util')
+
+describe('preview text transform', function()
+    after_each(function()
+        for src in pairs(preview.buffers) do
+            preview.close(src)
+        end
+        preview.transform = nil
+        preview.columns = 90
+    end)
+
+    it(
+        'converts copied text before table sizing and preserves source rows',
+        function()
+            local original = {
+                '# Heading',
+                '',
+                '| Formula | Value |',
+                '| --- | --- |',
+                '| $\\alpha$ | value |',
+                '',
+                '## After',
+            }
+            util.setup.text(original)
+            local src = vim.api.nvim_get_current_buf()
+            vim.bo[src].modified = false
+            local calls = 0
+            preview.columns = 30
+            preview.transform = function(buf, lines)
+                calls = calls + 1
+                assert.equal(src, buf)
+                assert.same(original, lines)
+                local result = vim.deepcopy(lines)
+                result[5] = '| α | value |'
+                return result
+            end
+            preview.open()
+            assert.equal(1, calls)
+            local dst = vim.api.nvim_get_current_buf()
+            assert.not_equal(src, dst)
+            local lines = vim.api.nvim_buf_get_lines(dst, 0, -1, false)
+            local found = false
+            for _, line in ipairs(lines) do
+                if line:find('α', 1, true) then
+                    found = true
+                    assert.is_nil(line:find('\\alpha', 1, true))
+                    assert.equal(30, vim.api.nvim_strwidth(line))
+                end
+            end
+            assert.is_true(found)
+            assert.same(original, vim.api.nvim_buf_get_lines(src, 0, -1, false))
+            assert.is_false(vim.bo[src].modified)
+            local doc = preview.docs[src]
+            assert.equal(6, doc.headings[2].source_row)
+            assert.equal('## After', doc.lines[doc.headings[2].preview_row + 1])
+            preview.close(src)
+            assert.same(original, vim.api.nvim_buf_get_lines(src, 0, -1, false))
+        end
+    )
+end)
