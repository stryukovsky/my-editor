diff --git a/lua/render-markdown/lib/fences.lua b/lua/render-markdown/lib/fences.lua
new file mode 100644
index 0000000..0a1f226
--- /dev/null
+++ b/lua/render-markdown/lib/fences.lua
@@ -0,0 +1,65 @@
+local M = {}
+
+---Keep all fenced code literal, including unclosed fences. Only complete
+---Mermaid nodes are converted. Treesitter excludes nested fence examples.
+---@param buf integer
+---@param lines string[]
+---@return table<integer, {source_end: integer, lines: string[], source?: string}>
+function M.collect(buf, lines)
+    local result = {}
+    local ok, parser = pcall(vim.treesitter.get_parser, buf, 'markdown')
+    if not ok or not parser then
+        -- Without a parser preserve fences rather than guessing at nesting.
+        local first, marker, length
+        for i, line in ipairs(lines) do
+            local run = line:match('^%s*(```+)[^`]*$')
+                or line:match('^%s*(~~~+)')
+            if not first and run then
+                first, marker, length = i, run:sub(1, 1), #run
+            elseif
+                first
+                and line:match(
+                    '^%s*' .. marker:rep(length) .. marker .. '*%s*$'
+                )
+            then
+                result[first - 1] =
+                    { source_end = i, lines = vim.list_slice(lines, first, i) }
+                first = nil
+            end
+        end
+        if first then
+            result[first - 1] =
+                { source_end = #lines, lines = vim.list_slice(lines, first) }
+        end
+        return result
+    end
+    local trees = parser:parse()
+    local query =
+        vim.treesitter.query.parse('markdown', '(fenced_code_block) @code')
+    for _, node in query:iter_captures(trees[1]:root(), buf, 0, -1) do
+        local start_row, _, end_row, end_col = node:range()
+        local stop = end_col == 0 and end_row or end_row + 1
+        local block = {
+            source_end = stop,
+            lines = vim.list_slice(lines, start_row + 1, stop),
+        }
+        result[start_row] = block
+        local delimiters, language, content = 0, nil, nil
+        for child in node:iter_children() do
+            if child:type() == 'fenced_code_block_delimiter' then
+                delimiters = delimiters + 1
+            elseif child:type() == 'info_string' then
+                language =
+                    vim.treesitter.get_node_text(child, buf):match('^%s*(%S+)')
+            elseif child:type() == 'code_fence_content' then
+                content = vim.treesitter.get_node_text(child, buf)
+            end
+        end
+        if delimiters == 2 and language and language:lower() == 'mermaid' then
+            block.source = (content or ''):gsub('\n$', '')
+        end
+    end
+    return result
+end
+
+return M
diff --git a/lua/render-markdown/lib/mermaid.lua b/lua/render-markdown/lib/mermaid.lua
new file mode 100644
index 0000000..e0a290d
--- /dev/null
+++ b/lua/render-markdown/lib/mermaid.lua
@@ -0,0 +1,95 @@
+local M = {}
+
+---A preview owns its renderer, cache and pending processes. Closing it cancels
+---all work; callers never receive results after close.
+---@param options {command: string, timeout: integer}
+function M.new(options)
+    local renderer = {
+        options = vim.deepcopy(options),
+        cache = {},
+        order = {},
+        pending = {},
+    }
+    local closed = false
+
+    function renderer:render(source, callback)
+        local cached = self.cache[source]
+        if cached then
+            return cached.lines
+        end
+        if self.pending[source] then
+            table.insert(self.pending[source].callbacks, callback)
+            return
+        end
+        local request = { callbacks = { callback } }
+        self.pending[source] = request
+        local function finish(result)
+            vim.schedule(function()
+                if closed then
+                    return
+                end
+                self.pending[source] = nil
+                local output = (result.stdout or '')
+                    :gsub('\27%[[%d;]*m', '')
+                    :gsub('\r\n', '\n')
+                local err
+                if result.code ~= 0 then
+                    err = vim.trim(result.stderr or '')
+                    if err == '' then
+                        err = 'exit code ' .. result.code
+                    end
+                elseif vim.trim(output) == '' then
+                    err = 'converter produced no output'
+                end
+                local lines
+                if not err then
+                    -- Remove the terminal newline, not spaces or interior empty rows.
+                    lines = vim.split(
+                        output:gsub('\n$', ''),
+                        '\n',
+                        { plain = true }
+                    )
+                end
+                if #self.order >= 10 then
+                    self.cache[table.remove(self.order, 1)] = nil
+                end
+                self.order[#self.order + 1] = source
+                self.cache[source] = { lines = lines }
+                if err then
+                    vim.notify(
+                        'Mermaid preview: ' .. err:match('[^\n]*'),
+                        vim.log.levels.WARN
+                    )
+                end
+                for _, done in ipairs(request.callbacks) do
+                    done(lines)
+                end
+            end)
+        end
+        local ok, process = pcall(vim.system, { options.command, '-f', '-' }, {
+            text = true,
+            stdin = source .. '\n',
+            env = { NO_COLOR = '1' },
+            timeout = options.timeout,
+        }, finish)
+        if ok then
+            request.process = process
+        else
+            finish({ code = -1, stderr = tostring(process) })
+        end
+    end
+
+    function renderer:close()
+        closed = true
+        for _, request in pairs(self.pending) do
+            if request.process then
+                request.process:kill(15)
+            end
+        end
+        self.pending = {}
+    end
+
+    return renderer
+end
+
+return M
