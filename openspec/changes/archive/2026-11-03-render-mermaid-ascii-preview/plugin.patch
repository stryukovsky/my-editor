+---@module 'luassert'
+local assert = require('luassert')
+local preview = require('render-markdown.core.preview')
+local util = require('tests.util')
+
+describe('preview Mermaid lifecycle', function()
+    local system, notify, calls, src, dst
+    before_each(function()
+        system, notify = vim.system, vim.notify
+        calls = {}
+        vim.notify = function() end
+        vim.system = function(_, opts, done)
+            local call = { stdin = opts.stdin, done = done }
+            calls[#calls + 1] = call
+            return {
+                kill = function()
+                    call.killed = true
+                end,
+            }
+        end
+    end)
+    -- selene: allow(undefined_variable)
+    after_each(function()
+        if src then
+            preview.close(src)
+        end
+        vim.system, vim.notify = system, notify
+    end)
+    local function open(lines)
+        util.setup.text(lines)
+        src = vim.api.nvim_get_current_buf()
+        preview.open()
+        dst = vim.api.nvim_get_current_buf()
+        assert.not_equal(src, dst)
+    end
+    local function text()
+        return vim.api.nvim_buf_get_lines(dst, 0, -1, false)
+    end
+
+    it(
+        'renders mixed blocks independently and preserves source state',
+        function()
+            local lines = {
+                '# Start',
+                '',
+                '```mermaid',
+                'graph LR',
+                'A-->B',
+                '```',
+                '',
+                '~~~mermaid',
+                'invalid',
+                '~~~',
+                '',
+                '# After',
+            }
+            open(lines)
+            local function heading_at_start()
+                local marks = vim.api.nvim_buf_get_extmarks(
+                    dst,
+                    require('render-markdown.core.ui').ns,
+                    0,
+                    -1,
+                    { details = true }
+                )
+                for _, mark in ipairs(marks) do
+                    if
+                        mark[2] == 0
+                        and mark[4].hl_group == 'RenderMarkdownH1Bg'
+                    then
+                        return true
+                    end
+                end
+                return false
+            end
+            assert.is_true(vim.wait(500, heading_at_start))
+            local modified = vim.bo[src].modified
+            local undo = vim.api.nvim_buf_call(src, vim.fn.undotree)
+            assert.equal(2, #calls)
+            local good = calls[1].stdin:find('graph LR', 1, true) and calls[1]
+                or calls[2]
+            local bad = good == calls[1] and calls[2] or calls[1]
+            good.done({ code = 0, stdout = '  A ---> B  \n\n second row\n' })
+            bad.done({ code = 1, stderr = 'invalid diagram' })
+            assert.is_true(vim.wait(500, function()
+                return text()[3] == '  A ---> B  '
+            end))
+            assert.same({
+                '# Start',
+                '',
+                '  A ---> B  ',
+                '',
+                ' second row',
+                '',
+                '~~~mermaid',
+                'invalid',
+                '~~~',
+                '',
+                '# After',
+            }, text())
+            assert.is_true(vim.wait(500, heading_at_start))
+            preview.refresh(src, dst)
+            assert.equal(2, #calls)
+            local row = preview.docs[src]:to_source(#text() - 1, 0)
+            assert.equal(#lines - 1, row)
+            vim.api.nvim_win_set_cursor(0, { #text(), 0 })
+            preview.close(src)
+            assert.equal(src, vim.api.nvim_get_current_buf())
+            assert.same(lines, vim.api.nvim_buf_get_lines(src, 0, -1, false))
+            assert.equal(modified, vim.bo[src].modified)
+            assert.same(undo, vim.fn.undotree())
+        end
+    )
+
+    it('ignores old source revisions and results after close/reopen', function()
+        open({ '```mermaid', 'old', '```' })
+        local old = calls[1]
+        vim.api.nvim_buf_set_lines(src, 1, 2, false, { 'new' })
+        preview.refresh(src, dst)
+        old.done({ code = 0, stdout = 'OLD' })
+        vim.wait(0)
+        assert.same({ '```mermaid', 'new', '```' }, text())
+        calls[2].done({ code = 0, stdout = 'NEW' })
+        assert.is_true(vim.wait(500, function()
+            return text()[1] == 'NEW'
+        end))
+        vim.api.nvim_buf_set_lines(src, 1, 2, false, { 'pending' })
+        preview.refresh(src, dst)
+        local pending = calls[3]
+        preview.close(src)
+        assert.is_true(pending.killed)
+        preview.open(src)
+        dst = vim.api.nvim_get_current_buf()
+        pending.done({ code = 0, stdout = 'STALE' })
+        vim.wait(0)
+        assert.same({ '```mermaid', 'pending', '```' }, text())
+        calls[4].done({ code = 0, stdout = 'FRESH' })
+        assert.is_true(vim.wait(500, function()
+            return text()[1] == 'FRESH'
+        end))
+    end)
+
+    it(
+        'deduplicates identical blocks and retains results beyond cache capacity',
+        function()
+            local lines = {}
+            for i = 1, 12 do
+                vim.list_extend(
+                    lines,
+                    { '```mermaid', 'diagram ' .. i, '```', '' }
+                )
+            end
+            vim.list_extend(lines, { '```mermaid', 'diagram 1', '```' })
+            open(lines)
+            assert.equal(12, #calls)
+            for _, call in ipairs(calls) do
+                call.done({ code = 0, stdout = call.stdin })
+            end
+            assert.is_true(vim.wait(500, function()
+                return #text() == 25
+            end))
+            assert.equal(12, #calls)
+            assert.equal('diagram 1', text()[25])
+        end
+    )
+
+    it(
+        'drops callbacks after source deletion and changed converter settings',
+        function()
+            open({ '```mermaid', 'old', '```' })
+            local old = calls[1]
+            local original = preview.mermaid
+            preview.mermaid = { command = 'different-converter', timeout = 500 }
+            preview.refresh(src, dst)
+            assert.is_true(old.killed)
+            old.done({ code = 0, stdout = 'OLD' })
+            vim.wait(0)
+            assert.same({ '```mermaid', 'old', '```' }, text())
+            vim.api.nvim_buf_delete(src, { force = true })
+            calls[2].done({ code = 0, stdout = 'DELETED' })
+            vim.wait(0)
+            assert.is_nil(preview.buffers[src])
+            assert.is_false(vim.api.nvim_buf_is_valid(dst))
+            preview.mermaid = original
+        end
+    )
+end)
diff --git a/tests/unit/fences_spec.lua b/tests/unit/fences_spec.lua
new file mode 100644
index 0000000..027ee99
--- /dev/null
+++ b/tests/unit/fences_spec.lua
@@ -0,0 +1,110 @@
+---@module 'luassert'
+local assert = require('luassert')
+local fences = require('render-markdown.lib.fences')
+local sync = require('render-markdown.sync')
+
+describe('preview fenced code', function()
+    local buf
+    before_each(function()
+        buf = vim.api.nvim_create_buf(false, true)
+    end)
+    -- selene: allow(undefined_variable)
+    after_each(function()
+        vim.api.nvim_buf_delete(buf, { force = true })
+    end)
+    local function collect(lines)
+        vim.api.nvim_buf_set_lines(buf, 0, -1, false, lines)
+        return fences.collect(buf, lines)
+    end
+
+    it('recognizes complete backtick and tilde Mermaid blocks only', function()
+        local blocks = collect({
+            '# Before',
+            '```mermaid',
+            'graph LR',
+            'A-->B',
+            '```',
+            '~~~mermaid',
+            'graph TD',
+            'B-->C',
+            '~~~',
+            '````markdown',
+            '```mermaid',
+            'literal example',
+            '```',
+            '````',
+            '```mermaid',
+            'unfinished',
+        })
+        assert.equal('graph LR\nA-->B', blocks[1].source)
+        assert.equal(5, blocks[1].source_end)
+        assert.equal('graph TD\nB-->C', blocks[5].source)
+        assert.is_nil(blocks[9].source)
+        assert.is_nil(blocks[10])
+        assert.is_nil(blocks[14].source)
+        assert.same({ '```mermaid', 'unfinished' }, blocks[14].lines)
+    end)
+
+    it(
+        'emits literal replacements without reflow, retaining mappings after diagrams',
+        function()
+            local lines = {
+                '# Before',
+                '```mermaid',
+                'graph LR',
+                'A-->B',
+                '```',
+                '# After',
+                '',
+                '| A | B |',
+                '| - | - |',
+                '| x | y |',
+            }
+            local blocks = collect(lines)
+            local wide = '  ' .. ('X '):rep(80) .. '  '
+            blocks[1].lines = { wide, '', '| not | a table |' }
+            local doc = sync.build(
+                lines,
+                { [7] = true, [8] = true, [9] = true },
+                40,
+                nil,
+                blocks
+            )
+            assert.equal(wide, doc.lines[2])
+            assert.equal('', doc.lines[3])
+            assert.equal('| not | a table |', doc.lines[4])
+            assert.equal('# After', doc.lines[5])
+            local row, col = doc:to_preview(5, 0)
+            assert.equal(4, row)
+            assert.equal(0, col)
+            row, col = doc:to_source(4, 0)
+            assert.equal(5, row)
+            assert.equal(0, col)
+            assert.equal('literal', doc.blocks[2].kind)
+            assert.equal('table', doc.blocks[#doc.blocks].kind)
+        end
+    )
+
+    it('keeps pending, failed, and other code fences byte-for-byte', function()
+        local long = '  ' .. ('code '):rep(40)
+        local lines = {
+            '```mermaid',
+            long,
+            '',
+            '| A | B |',
+            '| - | - |',
+            '```',
+            '~~~lua',
+            long,
+            '~~~',
+        }
+        local doc = sync.build(
+            lines,
+            { [3] = true, [4] = true },
+            20,
+            nil,
+            collect(lines)
+        )
+        assert.same(lines, doc.lines)
+    end)
+end)
diff --git a/tests/unit/mermaid_spec.lua b/tests/unit/mermaid_spec.lua
new file mode 100644
index 0000000..bf1fd8a
--- /dev/null
+++ b/tests/unit/mermaid_spec.lua
@@ -0,0 +1,137 @@
+---@module 'luassert'
+local assert = require('luassert')
+local mermaid = require('render-markdown.lib.mermaid')
+
+describe('Mermaid converter', function()
+    local system, notify, calls, notices, renderer
+    before_each(function()
+        system, notify = vim.system, vim.notify
+        calls, notices = {}, {}
+        vim.notify = function(message)
+            notices[#notices + 1] = message
+        end
+        vim.system = function(command, options, done)
+            local call = { command = command, options = options, done = done }
+            calls[#calls + 1] = call
+            return {
+                kill = function()
+                    call.killed = true
+                end,
+            }
+        end
+        renderer = mermaid.new({ command = 'mermaid-ascii', timeout = 500 })
+    end)
+    -- selene: allow(undefined_variable)
+    after_each(function()
+        renderer:close()
+        vim.system, vim.notify = system, notify
+    end)
+
+    it(
+        'uses stdin, cleans ANSI, preserves geometry, and deduplicates/cache inputs',
+        function()
+            local outputs = {}
+            for _ = 1, 2 do
+                renderer:render('graph LR\nA-->B', function(lines)
+                    outputs[#outputs + 1] = lines
+                end)
+            end
+            assert.equal(1, #calls)
+            assert.same({ 'mermaid-ascii', '-f', '-' }, calls[1].command)
+            assert.equal('graph LR\nA-->B\n', calls[1].options.stdin)
+            assert.equal('1', calls[1].options.env.NO_COLOR)
+            assert.equal(500, calls[1].options.timeout)
+            calls[1].done({
+                code = 0,
+                stdout = '\27[31m  A  \27[0m\r\n\r\n B \r\n',
+            })
+            assert.is_true(vim.wait(500, function()
+                return #outputs == 2
+            end))
+            assert.same({ '  A  ', '', ' B ' }, outputs[1])
+            assert.same(
+                outputs[1],
+                renderer:render('graph LR\nA-->B', function()
+                    error('cache miss')
+                end)
+            )
+            assert.equal(1, #calls)
+        end
+    )
+
+    it('caches failures and reports each unchanged failure once', function()
+        local completed = 0
+        renderer:render('bad', function(lines)
+            assert.is_nil(lines)
+            completed = completed + 1
+        end)
+        calls[1].done({ code = 1, stderr = 'invalid diagram\ntrace' })
+        assert.is_true(vim.wait(500, function()
+            return completed == 1
+        end))
+        renderer:render('bad', function()
+            error('repeated failure')
+        end)
+        assert.equal(1, #calls)
+        assert.same({ 'Mermaid preview: invalid diagram' }, notices)
+    end)
+
+    it('handles empty output and missing executables', function()
+        local completed = 0
+        renderer:render('empty', function(lines)
+            assert.is_nil(lines)
+            completed = completed + 1
+        end)
+        calls[1].done({ code = 0, stdout = '\n' })
+        vim.system = function()
+            error('executable not found')
+        end
+        renderer:render('missing', function(lines)
+            assert.is_nil(lines)
+            completed = completed + 1
+        end)
+        assert.is_true(vim.wait(500, function()
+            return completed == 2
+        end))
+        assert.equal(2, #notices)
+    end)
+
+    it('bounds cached results and cancels work on close', function()
+        for i = 1, 11 do
+            renderer:render(tostring(i), function() end)
+            calls[i].done({ code = 0, stdout = tostring(i) })
+            vim.wait(0)
+        end
+        assert.equal(10, vim.tbl_count(renderer.cache))
+        assert.is_nil(renderer.cache['1'])
+        local called = false
+        renderer:render('pending', function()
+            called = true
+        end)
+        renderer:close()
+        assert.is_true(calls[12].killed)
+        calls[12].done({ code = 0, stdout = 'late' })
+        vim.wait(0)
+        assert.is_false(called)
+    end)
+
+    it('times out a real process without blocking Neovim', function()
+        vim.system = system
+        local path = vim.fn.tempname()
+        vim.fn.writefile({ '#!/bin/sh', 'exec sleep 2' }, path)
+        vim.fn.setfperm(path, 'rwx------')
+        local timed = mermaid.new({ command = path, timeout = 30 })
+        local completed = false
+        timed:render('graph LR', function(lines)
+            assert.is_nil(lines)
+            completed = true
+        end)
+        assert.is_false(completed)
+        assert.is_true(vim.wait(1000, function()
+            return completed
+        end))
+        assert.equal(1, #notices)
+        timed:close()
+        vim.fn.delete(path)
+    end)
+end)
