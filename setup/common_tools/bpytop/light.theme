# Matte wheat paper — matches Neovim material-lighter
# (lua/configs/material-theme.lua + lua/highlight.lua)

# Colors should be in 6 or 2 character hexadecimal or single spaced rgb decimal: "#RRGGBB", "#BW" or "0-255 0-255 0-255"
# example for white: "#ffffff", "#ff" or "255 255 255".

# All graphs and meters can be gradients
# For single color graphs leave "mid" and "end" variable empty.
# Use "start" and "end" variables for two color gradient
# Use "start", "mid" and "end" for three color gradient

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#f7f1e3"

# Main text color
theme[main_fg]="#5d5140"

# Title color for boxes
theme[title]="#c49a2e"

# Higlight color for keyboard shortcuts
theme[hi_fg]="#c45a12"

# Background color of selected item in processes box
theme[selected_bg]="#e5d5a6"

# Foreground color of selected item in processes box
theme[selected_fg]="#765613"

# Color of inactive/disabled text
theme[inactive_fg]="#9b8a72"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#c49a2e"

# Cpu box outline color
theme[cpu_box]="#c49a2e"

# Memory/disks box outline color
theme[mem_box]="#91B859"

# Net up/down box outline color
theme[net_box]="#c45a12"

# Processes box outline color
theme[proc_box]="#6182B8"

# Box divider line and small boxes line color
theme[div_line]="#d8c8aa"

# Temperature graph colors
theme[temp_start]="#91B859"
theme[temp_mid]="#c49a2e"
theme[temp_end]="#E53935"

# CPU graph colors
theme[cpu_start]="#c49a2e"
theme[cpu_mid]="#c45a12"
theme[cpu_end]="#E53935"

# Mem/Disk free meter
theme[free_start]="#c5b79e"
theme[free_mid]="#c49a2e"
theme[free_end]="#E53935"

# Mem/Disk cached meter
theme[cached_start]="#6182B8"
theme[cached_mid]="#8796B0"
theme[cached_end]="#39ADB5"

# Mem/Disk available meter
theme[available_start]="#c49a2e"
theme[available_mid]="#c45a12"
theme[available_end]="#F76D47"

# Mem/Disk used meter
theme[used_start]="#91B859"
theme[used_mid]="#39ADB5"
theme[used_end]="#6182B8"

# Download graph colors
theme[download_start]="#6182B8"
theme[download_mid]="#39ADB5"
theme[download_end]="#91B859"

# Upload graph colors
theme[upload_start]="#7C4DFF"
theme[upload_mid]="#c49a2e"
theme[upload_end]="#c45a12"

