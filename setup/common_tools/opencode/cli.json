{
  "$schema": "https://opencode.ai/v2/cli.json",
  "tabs": {
    "mode": "on",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "keybinds": {
    "session.tab.previous": { "name": ",", "meta": true },
    "session.tab.next": "alt+.",
    "session.new": ["alt+n", "<leader>n"]
  },
  "theme": {
    "name": "gruvbox"
  }
}
