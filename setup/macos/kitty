# Window
remember_window_size yes
# Keep traffic lights so the window stays draggable; hide the title text.
hide_window_decorations titlebar-only
confirm_os_window_close 0
window_padding_width 6 10
window_margin_width 0
placement_strategy center

# Font
font_family AdwaitaMono Nerd Font
font_size 10.5
bold_font auto
italic_font auto
bold_italic_font auto
disable_ligatures cursor
adjust_line_height 115%
modify_font underline_thickness 150%
modify_font underline_position 2

# Material Deep Ocean (matches nvim night theme)
foreground #A6ACCD
background #0F111A
selection_foreground #FFFFFF
selection_background #1F2233
cursor #82AAFF
cursor_text_color #0F111A
url_color #82AAFF

color0  #0F111A
color8  #464B5D
color1  #FF5370
color9  #FF5370
color2  #C3E88D
color10 #C3E88D
color3  #FFCB6B
color11 #F78C6C
color4  #82AAFF
color12 #82AAFF
color5  #C792EA
color13 #C792EA
color6  #89DDFF
color14 #89DDFF
color7  #EEFFFF
color15 #FFFFFF

# Background
background_opacity 1.0
inactive_text_alpha 0.62

# Shell
shell zsh
# Ghostty: shell-integration-features = no-cursor
shell_integration enabled no-cursor

# Clipboard
clipboard_control write-clipboard write-primary read-clipboard read-primary
copy_on_select no
strip_trailing_spaces smart
paste_actions quote-urls-at-prompt,confirm

# macOS: Option as Alt/Meta so Neovim <A-*> and shell Alt bindings work.
# Reload is not enough; fully quit and reopen kitty after changing this.
# `left` keeps Right Option for accents (é, ñ); use `yes` if both Options must be Alt.
macos_option_as_alt yes
macos_show_window_title_in menubar
macos_menubar_title_max_length 40
macos_quit_when_last_window_closed yes

# Cursor (nvim draws its own; hide the terminal caret)
cursor none
cursor_shape block
cursor_beam_thickness 1.5
mouse_hide_wait 3.0

# Remote control from Neovim (`kitten @ launch`, project tabs)
# Per-pid socket (not /tmp/mykitty): KITTY_LISTEN_ON is unique per OS window,
# and /tmp on macOS is not a reliable place for long-lived sockets.
allow_remote_control socket-only
listen_on unix:${HOME}/.cache/kitty/mykitty

# Scrollback / urls
scrollback_lines 20000
url_style curly
underline_hyperlinks hover
detect_urls yes

# Bell
enable_audio_bell no
visual_bell_duration 0
bell_on_tab no

# New tabs/windows inherit the current working directory
# (Ghostty: window-inherit-working-directory = true)

# --- macOS rendering ---
# 8 ms ≈ 120 Hz ProMotion. Use 16 on a 60 Hz display if CPU climbs or you see tearing.
repaint_delay 8
# Smallest useful key-to-pixel latency without starving the renderer.
input_delay 1
# Lock redraws to the display refresh. Turn off if you see hitching on mixed-Hz setups.
sync_to_monitor yes
# Extra stem weight against Core Text grayscale AA. 0.5 is the sweet spot for
# Adwaita Mono; higher muddies Nerd Font icons.
macos_thicken_font 0.50
# Display P3 matches modern Mac panels; default sRGB looks washed out.
macos_colorspace displayp3
# Gamma + contrast for Core Text. `legacy` is sharper on some fonts, blurrier on others.
text_composition_strategy 1.7 40

# Move word-wise with Alt + Left/Right
map alt+left send_text all \x1bb
map alt+right send_text all \x1bf

# Move word-wise with Ctrl + Left/Right
map ctrl+left send_text all \x1b[1;5D
map ctrl+right send_text all \x1b[1;5C

# Delete word-wise with Alt/Ctrl + Backspace
map alt+backspace send_text all \x1b\x7f
map ctrl+backspace send_text all \x1b\x7f

# Delete word AFTER cursor with Alt/Ctrl + Delete
map alt+delete send_text all \x1bd
map ctrl+delete send_text all \x1bd

# Window management (cmd is Super/Command)
# cmd+q is previous_tab on purpose (same as Ghostty). Use cmd+q then cmd+w to quit,
# or kitty → Quit from the menu. Reload does not remake these maps.
map ctrl+t new_tab_with_cwd
map cmd+t new_tab_with_cwd
map ctrl+q previous_tab
map cmd+q previous_tab
map ctrl+e next_tab
map cmd+e next_tab
map ctrl+n new_os_window_with_cwd
map cmd+n new_os_window_with_cwd
map ctrl+w close_tab
map cmd+w close_tab

# Tabs
tab_bar_edge            top
tab_bar_align           left
tab_bar_style           powerline
tab_powerline_style     slanted
tab_bar_min_tabs        1
tab_bar_margin_height   0 0
tab_title_template      " {index} {title[:32]} "
active_tab_font_style   bold
inactive_tab_font_style normal
active_tab_foreground   #0F111A
active_tab_background   #82AAFF
inactive_tab_foreground #8F93A2
inactive_tab_background #1A1C25
tab_bar_background      #0B0D14
tab_bar_margin_color    #0B0D14
active_border_color     #82AAFF
inactive_border_color   #1A1C25
