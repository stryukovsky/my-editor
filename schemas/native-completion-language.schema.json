{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native completion language mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "language",
    "fixtures"
  ],
  "anyOf": [
    {
      "required": [
        "extends"
      ]
    },
    {
      "required": [
        "identifier_nodes",
        "comment_nodes",
        "string_nodes",
        "expressions",
        "string_contexts",
        "keywords"
      ]
    }
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "extends": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "identifier_nodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "comment_nodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "string_nodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "expressions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/expression_nodes"
        },
        "method": {
          "$ref": "#/$defs/expression_nodes"
        },
        "member": {
          "$ref": "#/$defs/expression_nodes"
        },
        "import": {
          "$ref": "#/$defs/expression_nodes"
        }
      }
    },
    "string_contexts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/nodes"
        },
        "method": {
          "$ref": "#/$defs/nodes"
        },
        "member": {
          "$ref": "#/$defs/nodes"
        },
        "import": {
          "$ref": "#/$defs/nodes"
        }
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "expect"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "pattern": "<cursor>"
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "context"
            ],
            "properties": {
              "context": {
                "enum": [
                  "unknown",
                  "type",
                  "method",
                  "member",
                  "import"
                ]
              },
              "identifiers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "affinity": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "ranking": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2,
                "uniqueItems": true
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "expression_nodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node",
              "field"
            ],
            "properties": {
              "node": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "field": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "requires": {
                "$ref": "#/$defs/nodes"
              },
              "unless_ancestor": {
                "$ref": "#/$defs/nodes"
              }
            }
          }
        ]
      }
    }
  }
}
